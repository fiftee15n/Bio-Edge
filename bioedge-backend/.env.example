# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_bioedge_2026

# Allowed Frontend Origins for CORS (* or your Vercel URL)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Gmail SMTP Configuration for Real Verification Code Delivery
# 1. Enter your Gmail address:
GMAIL_USER=your_gmail_here@gmail.com

# 2. Enter your 16-character Google App Password (not your normal Gmail password!):
# Generated at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional SMTP Settings (defaults to smtp.gmail.com:465 SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_FROM="Bio Edge by Afroza Tahmina" <your_gmail_here@gmail.com>
